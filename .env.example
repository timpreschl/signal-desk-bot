# Kopiere diese Datei auf dem Server zu ".env" und trage dort deine echten Werte ein.
# WICHTIG: Diese Datei (.env) niemals in Chats/E-Mails/Git einfügen - nur direkt auf dem Server bearbeiten.

# API-Keys des ZWEITEN, getrennten Alpaca-Paper-Accounts (nicht das bestehende System!)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper-Trading-Endpoint (fuer echtes Geld spaeter auf https://api.alpaca.markets aendern)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Risikomanagement-Grundeinstellungen
MAX_OPEN_POSITIONS=5
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
